# ── Evaluation LLM — Source 1: per-org config from the NIA database (PRODUCTION) ─
# When the NIA DB is configured, Metron resolves each org's provider/model/key from
# the platform's NIA DB (application_llm_config), keyed by organization_id (from the
# JWT) + METRON_APPLICATION_NAME, and KMS-decrypts the provider config. Get these
# values from the platform team.
#
# Nia Database Configuration
NIA_DB_HOST=your_db_host
NIA_DB_NAME=unified_qa_db
NIA_DB_PASSWORD=your_db_password
NIA_DB_PORT=5432
NIA_DB_USER=your_dev_user
# SSL: defaults to psycopg2 "prefer" (TLS if available, else plaintext).
# Set to "require" only if the NIA DB mandates TLS.
# NIA_DB_SSLMODE=
# (Alternatively, a single SQLAlchemy URL — takes precedence if set:)
# NIA_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/unified_qa_db
METRON_APPLICATION_NAME=RAI_SERVICE
# NIA agent mode: the team_id of the A2A agent under test (baked into the request
# body; the agent uses it to select its own LLM). The UI shows only the endpoint +
# Test Connection; the request template, response path, trim marker and auth are
# fixed server-side, and the caller's JWT is injected from the Authorization header.
METRON_NIA_TEAM_ID=
METRON_DEV_AGENT_TOKEN=
# AWS KMS credentials used to decrypt the provider config from the NIA DB:
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Evaluation LLM — Source 2: .env fallback (LOCAL DEV, when NIA_DATABASE_URL unset) ─
# litellm routes by the model prefix; one model is used for all tasks.
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=
# Optional rate-limit override (requests/min):
# LLM_RPM=60
#   Groq:    LLM_MODEL=groq/llama-3.3-70b-versatile
#   NVIDIA:  LLM_MODEL=nvidia_nim/meta/llama-3.1-70b-instruct
#   Azure:   LLM_MODEL=azure/gpt-4o   (also set AZURE_OPENAI_ENDPOINT, AZURE_API_VERSION)
#   Bedrock: LLM_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0
#            (uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION instead of LLM_API_KEY)
# Optional: exercise the NIA per-org path locally in bypass mode by setting a dev org id:
# METRON_DEV_ORG_ID=

# ── Local dev bypass (REMOVE before deploying to the platform) ───────────────
# Set to 1 to skip Keycloak token verification entirely.
# Lets you run the full app locally without a real Keycloak instance.
# NEVER set this in production — it disables all authentication.
METRON_AUTH_BYPASS=1
# Local testing against a real NIA A2A agent: paste a valid token here and it is
# injected into the A2A request body (the {{token}} placeholder). You can paste the
# full gateway token (…$YashUnified2025$…) or the bare JWT — the marker is stripped.
# Only used when METRON_AUTH_BYPASS=1. Leave empty otherwise.
# METRON_DEV_AGENT_TOKEN=

# ── Auth (Keycloak) ───────────────────────────────────────────────────────────
# Metron runs embedded behind the host platform's reverse proxy, which injects an
# "Authorization: Bearer <token>" header with a Keycloak access token. The backend
# only VERIFIES that token (signature + issuer). Authorization is removed — any
# valid token gets full access — so there is no role/tenant/quota config here.
#
# Required: point these at the host platform's Keycloak realm.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=metron
# Optional: if set, the token's `aud` claim is verified against this value.
# Leave blank to skip audience checks (Keycloak access tokens often use aud="account").
KEYCLOAK_AUDIENCE=
# Optional overrides if your Keycloak is behind a non-standard path (e.g. legacy /auth):
# KEYCLOAK_ISSUER=https://auth.example.com/realms/metron
# KEYCLOAK_JWKS_URL=https://auth.example.com/realms/metron/protocol/openid-connect/certs

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to "true" once you have HTTPS/SSL configured (nginx + certbot)
METRON_SECURE_COOKIE=false

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Run history + project configs are stored in Postgres. SSL is forced
# (sslmode=require) in code — required by Supabase and most managed Postgres.
# For Supabase, DB_USER is "postgres.<project-ref>" and DB_HOST is the pooler host.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
# Add your server's public IP or domain here.
# Example: CORS_ORIGINS=http://1.2.3.4,https://yourdomain.com
CORS_ORIGINS=

# ── Frontend (optional — set if backend is not on localhost:8000) ─────────────
# NEXT_PUBLIC_API_URL=http://your-server-ip:8000

# ── MLflow — LLMOps token tracking ────────────────────────────────────────────
# Local dev:   sqlite:///mlruns/mlflow.db  (no separate server needed)
#              OR http://127.0.0.1:5000    (if running: mlflow server --port 5000)
# EC2 prod:    sqlite:////opt/metron/mlruns/mlflow.db  (absolute path on EBS volume)
#              OR http://localhost:5000    (same machine MLflow server)
#
# Start MLflow UI (read-only):
#   mlflow ui --backend-store-uri sqlite:///mlruns/mlflow.db --host 0.0.0.0 --port 5000
#
# Leave blank to disable token tracking entirely (pipeline runs unchanged).
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_EXPERIMENT_NAME=metron-llmops

